{
  "name": "medusa-base",
  "version": "0.0.1",
  "description": "Base.com (formerly BaseLinker) integration for MedusaJS v2 - catalog and stock sync, order export, status and tracking sync back",
  "license": "MIT",
  "author": "Micha\u0142 Bystryk (https://digity.studio/)",
  "homepage": "https://digity.studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/michalbystryk/medusa-base.git"
  },
  "keywords": [
    "medusa-plugin-integration",
    "medusa-v2",
    "medusa-plugin",
    "base",
    "base.com",
    "baselinker",
    "erp"
  ],
  "exports": {
    ".": "./.medusa/server/src/index.js",
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js"
  },
  "files": [
    ".medusa",
    "!.medusa/server/**/__tests__/**",
    "!.medusa/server/**/__mocks__/**"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "pack:local": "npm run build && npm pack",
    "recon": "tsx scripts/recon.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "node --test --import tsx src/lib/__tests__/*.test.ts"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.13.5",
    "@medusajs/cli": "^2.13.5",
    "@medusajs/framework": "^2.13.5",
    "@medusajs/icons": "2.13.5",
    "@medusajs/medusa": "^2.13.5",
    "@medusajs/test-utils": "^2.13.5",
    "@medusajs/ui": "4.1.5",
    "@swc/core": "^1.7.28",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11"
  },
  "engines": {
    "node": ">=20"
  }
}
